@model SunwinInventory.DTOs.Supplier.SupplierDto

@{
    ViewData["Title"] = "Edit Supplier";
}

<div class="card shadow-sm">

    <div class="card-header">

        <h4>
            <i class="bi bi-pencil-square"></i>
            Edit Supplier
        </h4>

    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post">

            <input asp-for="SupplierId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">

                <div class="col-md-3 mb-3">

                    <label asp-for="SupplierCode" class="form-label"></label>

                    <input asp-for="SupplierCode" class="form-control" />

                    <span asp-validation-for="SupplierCode" class="text-danger"></span>

                </div>

                <div class="col-md-9 mb-3">

                    <label asp-for="SupplierName" class="form-label"></label>

                    <input asp-for="SupplierName" class="form-control" />

                    <span asp-validation-for="SupplierName" class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="ContactPerson" class="form-label"></label>

                    <input asp-for="ContactPerson" class="form-control" />

                    <span asp-validation-for="ContactPerson" class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Phone" class="form-label"></label>

                    <input asp-for="Phone" class="form-control" />

                    <span asp-validation-for="Phone" class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Email" class="form-label"></label>

                    <input asp-for="Email" class="form-control" />

                    <span asp-validation-for="Email" class="text-danger"></span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="Country" class="form-label"></label>

                    <input asp-for="Country" class="form-control" />

                    <span asp-validation-for="Country" class="text-danger"></span>

                </div>

                <div class="col-md-12 mb-3">

                    <label asp-for="Address" class="form-label"></label>

                    <textarea asp-for="Address"
                              rows="3"
                              class="form-control"></textarea>

                    <span asp-validation-for="Address" class="text-danger"></span>

                </div>

                <div class="col-md-12 mb-3">

                    <div class="form-check form-switch">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label class="form-check-label"
                               asp-for="IsActive">

                            Active

                        </label>

                    </div>

                </div>

            </div>

            <hr />

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-save"></i>

                Update

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Back

            </a>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}