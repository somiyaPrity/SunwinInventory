@model SunwinInventory.DTOs.Customer.CustomerDto

@{
    ViewData["Title"] = "Add Customer";
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="bi bi-person-plus"></i>
                Add Customer
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                   @*  <div class="col-md-6 mb-3">

                        <label asp-for="CustomerCode"
                               class="form-label">
                            Customer Code
                        </label>

                        <input asp-for="CustomerCode"
                               class="form-control"
                               placeholder="Enter customer code" />

                        <span asp-validation-for="CustomerCode"
                              class="text-danger">
                        </span>

                    </div> *@

                    <div class="col-md-6 mb-3">

                        <label asp-for="CustomerName"
                               class="form-label">
                            Customer Name
                        </label>

                        <input asp-for="CustomerName"
                               class="form-control"
                               placeholder="Enter customer name" />

                        <span asp-validation-for="CustomerName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="ContactPerson"
                               class="form-label">
                            Contact Person
                        </label>

                        <input asp-for="ContactPerson"
                               class="form-control"
                               placeholder="Enter contact person" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Mobile"
                               class="form-label">
                            Mobile
                        </label>

                        <input asp-for="Mobile"
                               class="form-control"
                               placeholder="Enter mobile number" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter email" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Address"
                               class="form-label">
                            Address
                        </label>

                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Enter address">
                        </textarea>

                    </div>

                    <div class="col-md-6 mb-3">

                        <div class="form-check mt-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active
                            </label>

                        </div>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Back

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save"></i>
                        Save Customer

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}