@model SunwinInventory.DTOs.Account.LoginDto

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login | SUNWIN ERP</title>

    <!-- Bootstrap -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>

        :root {
            --brand-dark: #1f2937;
            --brand-darker: #111827;
            --brand-accent: #ff8c00;
            --page-bg: #f4f6f9;
            --text-muted: #6b7280;
        }

        html,
        body {
            height: 100%;
        }

        body {
            margin: 0;
            font-family: 'Poppins', system-ui, -apple-system, 'Segoe UI', sans-serif;
            background: var(--page-bg);
            color: #1f2937;
        }

        .login-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        }

        /* ---------- Brand panel ---------- */

        .brand-panel {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 40px;
            padding: 56px;
            color: #e5e7eb;
            background:
                radial-gradient(1100px 520px at 12% -10%, rgba(255, 140, 0, .20), transparent 60%),
                linear-gradient(160deg, var(--brand-darker) 0%, var(--brand-dark) 55%, #0f172a 100%);
        }

            .brand-panel::before,
            .brand-panel::after {
                content: "";
                position: absolute;
                border-radius: 50%;
                border: 1px solid rgba(255, 255, 255, .06);
                pointer-events: none;
            }

            .brand-panel::before {
                width: 520px;
                height: 520px;
                right: -180px;
                top: -160px;
            }

            .brand-panel::after {
                width: 340px;
                height: 340px;
                right: -120px;
                bottom: -140px;
                border-color: rgba(255, 140, 0, .18);
            }

        .logo-card {
            display: inline-flex;
            align-items: center;
            background: #fff;
            border-radius: 18px;
            padding: 18px 22px;
            box-shadow: 0 18px 40px rgba(0, 0, 0, .35);
            width: fit-content;
        }

            .logo-card img {
                width: 230px;
                max-width: 100%;
                height: auto;
            }

        .brand-title {
            margin: 32px 0 8px;
            font-size: 2rem;
            font-weight: 600;
            letter-spacing: -.02em;
            color: #fff;
        }

        .brand-subtitle {
            margin: 0;
            color: #9ca3af;
            font-size: .95rem;
        }

        .brand-points {
            position: relative;
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 20px;
            max-width: 420px;
        }

            .brand-points li {
                display: flex;
                gap: 14px;
                align-items: flex-start;
            }

        .point-icon {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255, 140, 0, .14);
            color: #ffb457;
            font-size: 1.15rem;
        }

        .brand-points strong {
            display: block;
            color: #f3f4f6;
            font-size: .95rem;
            font-weight: 600;
        }

        .brand-points span {
            color: #9ca3af;
            font-size: .82rem;
            line-height: 1.6;
        }

        .brand-foot {
            font-size: .78rem;
            color: #6b7280;
            position: relative;
        }

        /* ---------- Form panel ---------- */

        .form-panel {
            display: grid;
            place-items: center;
            padding: 40px 24px;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border: 1px solid #eef0f4;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, .08);
        }

        .mobile-logo {
            display: none;
            margin-bottom: 24px;
        }

            .mobile-logo img {
                width: 190px;
                max-width: 100%;
                height: auto;
            }

        .login-card h2 {
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: -.01em;
            margin: 0 0 6px;
        }

        .login-subtitle {
            margin: 0 0 24px;
            color: var(--text-muted);
            font-size: .88rem;
        }

        .form-label {
            font-size: .85rem;
            font-weight: 500;
            color: #374151;
            margin-bottom: 6px;
        }

        .login-input .input-group-text {
            background: #fff;
            border-right: 0;
            border-color: #e5e7eb;
            color: #9ca3af;
            border-radius: 12px 0 0 12px;
            padding-left: 14px;
            padding-right: 10px;
        }

        .login-input .form-control {
            border-left: 0;
            border-right: 0;
            border-color: #e5e7eb;
            padding: .7rem .75rem;
            font-size: .9rem;
            color: #1f2937;
        }

            .login-input .form-control:focus {
                border-color: #e5e7eb;
                box-shadow: none;
            }

        .login-input .input-group-text,
        .login-input .form-control {
            transition: border-color .15s ease;
        }

        .login-input:focus-within .input-group-text,
        .login-input:focus-within .form-control {
            border-color: rgba(255, 140, 0, .8);
        }

        .login-input {
            border-radius: 12px;
        }

            .login-input:focus-within {
                box-shadow: 0 0 0 4px rgba(255, 140, 0, .14);
                border-radius: 12px;
            }

        .btn-toggle-password {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-left: 0;
            color: #9ca3af;
            border-radius: 0 12px 12px 0;
            padding: 0 14px;
        }

            .btn-toggle-password:hover,
            .btn-toggle-password:focus {
                background: #fff;
                color: #1f2937;
                box-shadow: none;
            }

        .btn-login {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            width: 100%;
            padding: .8rem 1rem;
            border: 0;
            border-radius: 12px;
            background: var(--brand-dark);
            color: #fff;
            font-size: .92rem;
            font-weight: 600;
            letter-spacing: .01em;
            transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
        }

            .btn-login:hover,
            .btn-login:focus-visible {
                background: var(--brand-darker);
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 12px 24px rgba(17, 24, 39, .18);
            }

            .btn-login:focus-visible {
                outline: 0;
                box-shadow: 0 0 0 4px rgba(255, 140, 0, .28);
            }

        .login-alert {
            border: 0;
            border-radius: 12px;
            font-size: .85rem;
        }

        .field-validation-error {
            display: block;
            margin-top: 6px;
        }

        .login-help {
            margin: 20px 0 0;
            text-align: center;
            font-size: .78rem;
            color: var(--text-muted);
        }

        @@media (max-width: 991.98px) {

            .login-shell {
                grid-template-columns: minmax(0, 1fr);
            }

            .brand-panel {
                display: none;
            }

            .mobile-logo {
                display: block;
            }

            .login-card {
                padding: 32px 26px;
                box-shadow: 0 18px 40px rgba(15, 23, 42, .09);
            }
        }

        @@media (max-width: 575.98px) {

            .form-panel {
                padding: 24px 16px;
                align-content: start;
            }

            .login-card {
                border: 0;
                box-shadow: none;
                background: transparent;
                padding: 16px 4px;
            }
        }

    </style>

</head>

<body>

    <div class="login-shell">

        <!-- ===================================================== -->
        <!-- BRAND PANEL -->
        <!-- ===================================================== -->

        <aside class="brand-panel">

            <div>

                <div class="logo-card">

                    <img src="~/images/sunwin-logo.png"
                         alt="Sunwin Ltd. — Plastic & Electrical Insulation" />

                </div>

                <h1 class="brand-title">
                    Inventory &amp; Sales ERP
                </h1>

                <p class="brand-subtitle">
                    Plastic &amp; Electrical Insulation
                </p>

            </div>

            <ul class="brand-points">

                <li>

                    <span class="point-icon">
                        <i class="bi bi-box-seam"></i>
                    </span>

                    <div>
                        <strong>Stock across every location</strong>
                        <span>Live quantities and weights by warehouse, shipment and size.</span>
                    </div>

                </li>

                <li>

                    <span class="point-icon">
                        <i class="bi bi-receipt"></i>
                    </span>

                    <div>
                        <strong>Sales and collections</strong>
                        <span>Invoice entry, customer dues and payment history in one place.</span>
                    </div>

                </li>

                <li>

                    <span class="point-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </span>

                    <div>
                        <strong>Reports ready to share</strong>
                        <span>Sales, stock and receivable reports exported to Excel.</span>
                    </div>

                </li>

            </ul>

            <div class="brand-foot">
                &copy; @DateTime.Now.Year Sunwin Ltd. All rights reserved.
            </div>

        </aside>


        <!-- ===================================================== -->
        <!-- FORM PANEL -->
        <!-- ===================================================== -->

        <main class="form-panel">

            <div class="login-card">

                <div class="mobile-logo">

                    <img src="~/images/sunwin-logo.png"
                         alt="Sunwin Ltd." />

                </div>

                <h2>Welcome back</h2>

                <p class="login-subtitle">
                    Sign in to continue to your dashboard.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger login-alert" role="alert">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        @ViewBag.Error

                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success login-alert" role="alert">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        @TempData["Success"]

                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger login-alert" role="alert">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        @TempData["Error"]

                    </div>
                }

                <form asp-action="Login">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="UserName"
                               class="form-label">

                            User Name

                        </label>

                        <div class="input-group login-input">

                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>

                            <input asp-for="UserName"
                                   class="form-control"
                                   placeholder="Enter your user name"
                                   autocomplete="username"
                                   autofocus />

                        </div>

                        <span asp-validation-for="UserName"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="Password"
                               class="form-label">

                            Password

                        </label>

                        <div class="input-group login-input">

                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />

                            <button type="button"
                                    class="btn btn-toggle-password"
                                    id="togglePassword"
                                    aria-label="Show password"
                                    tabindex="-1">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>

                    </div>

                    <button type="submit"
                            class="btn-login">

                        <i class="bi bi-box-arrow-in-right"></i>
                        Sign In

                    </button>

                </form>

                <p class="login-help">
                    Trouble signing in? Contact your system administrator.
                </p>

            </div>

        </main>

    </div>

    <script>

        (function () {

            const toggle = document.getElementById('togglePassword');

            const input = document.getElementById('Password');

            if (!toggle || !input) {
                return;
            }

            toggle.addEventListener('click', function () {

                const show = input.type === 'password';

                input.type = show ? 'text' : 'password';

                toggle.innerHTML = show
                    ? '<i class="bi bi-eye-slash"></i>'
                    : '<i class="bi bi-eye"></i>';

                toggle.setAttribute(
                    'aria-label',
                    show ? 'Hide password' : 'Show password');
            });

        })();

    </script>

</body>

</html>
