@model IEnumerable<SunwinInventory.DTOs.ProductPurchaseDetail.PurchaseReportDto>

@{
    ViewData["Title"] = "Purchase Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between">

        <h4>Purchase Report</h4>

        <div>

            <a asp-action="Create" class="btn btn-light">
                <i class="bi bi-plus-circle"></i>
                New Purchase
            </a>
            <a asp-action="ExportExcel"
               asp-route-FromDate="@ViewBag.Filter?.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-ToDate="@ViewBag.Filter?.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-SupplierId="@ViewBag.Filter?.SupplierId"
               asp-route-WarehouseId="@ViewBag.Filter?.WarehouseId"
               asp-route-ShipmentId="@ViewBag.Filter?.ShipmentId"
               asp-route-ProductNameId="@ViewBag.Filter?.ProductNameId"
               class="btn btn-success">

                <i class="bi bi-file-earmark-excel"></i>
                Export Excel

            </a>
           @*  <a asp-action="ExportExcel"
               class="btn btn-success">

                <i class="bi bi-file-earmark-excel"></i>

                Export Excel

            </a> *@

        </div>

    </div>
    <div class="card shadow mt-3">

        <div class="card-header text-white border-bottom-0">

            <form asp-action="Index" method="get">

                <div class="row mb-3 mt-4">

                    <div class="col-md-2">
                        <label>From Date</label>

                        <input type="date"
                               name="FromDate"
                               class="form-control"
                               value="@ViewBag.Filter?.FromDate?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-2">
                        <label>To Date</label>

                        <input type="date"
                               name="ToDate"
                               class="form-control"
                               value="@ViewBag.Filter?.ToDate?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-2">

                        <label>Supplier</label>

                        <select name="SupplierId" class="form-select">

                            <option value="">All Suppliers</option>

                            @foreach (var item in ViewBag.Suppliers)
                            {
                                if (ViewBag.Filter?.SupplierId?.ToString() == item.Value)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label>Warehouse</label>

                        <select name="WarehouseId" class="form-select">

                            <option value="">All Warehouses</option>

                            @foreach (var item in ViewBag.Warehouses)
                            {
                                if (ViewBag.Filter?.WarehouseId?.ToString() == item.Value)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label>Shipment</label>

                        <select name="ShipmentId" class="form-select">

                            <option value="">All Shipments</option>

                            @foreach (var item in ViewBag.Shipments)
                            {
                                if (ViewBag.Filter?.ShipmentId?.ToString() == item.Value)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-2 d-flex align-items-end">

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Search
                        </button>

                    </div>

                </div>
                <div class="row">
                    <div class="col-md-3 d-flex align-items-end">

                        <a asp-action="Index"
                           class="btn btn-secondary w-100">

                            Clear

                        </a>

                    </div>
                </div>
            </form>

        </div>
    </div>
    <div class="row mt-4">

        <!-- Total Quantity -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Total Quantity (PCS)</h6>
                            <h2 class="fw-bold mb-0">
                                @Model.Sum(x => x.InitialQuantity).ToString("N0")
                            </h2>
                        </div>
                        <i class="bi bi-box-seam fs-1"></i>
                    </div>
                </div>
            </div>
        </div>


        <!-- Total Weight -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Total Weight (KG)</h6>
                            <h2 class="fw-bold mb-0">
                                @Model.Sum(x => x.TotalWeightKg).ToString("N2")
                            </h2>
                        </div>
                        <i class="bi bi-speedometer2 fs-1"></i>
                    </div>
                </div>
            </div>
        </div>


        <!-- Total Cost Without Tax - Taka -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Cost Without Tax (Taka)</h6>
                            <h2 class="fw-bold mb-0">
                                ৳ @Model.Sum(x => x.TotalAmountWithoutTaxTk).ToString("N2")
                            </h2>
                        </div>
                        <i class="bi bi-currency-exchange fs-1"></i>
                    </div>
                </div>
            </div>
        </div>


        <!-- Total Cost Without Tax - RMB -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm bg-secondary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Cost Without Tax (RMB)</h6>
                            <h2 class="fw-bold mb-0">
                                ¥ @Model.Sum(x => x.TotalAmountWithoutTaxRmb).ToString("N2")
                            </h2>
                        </div>
                        <i class="bi bi-cash-stack fs-1"></i>
                    </div>
                </div>
            </div>
        </div>


        <!-- Import Tax -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Import Tax Applied (Taka)</h6>
                            <h2 class="fw-bold mb-0">
                                ৳ @Model.Sum(x =>
                                       x.ImportTaxPerKgTk * x.TotalWeightKg
                                       ).ToString("N2")
                            </h2>
                        </div>
                        <i class="bi bi-percent fs-1"></i>
                    </div>
                </div>
            </div>
        </div>


        <!-- Total Cost With Tax - Taka -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Cost With Tax (Taka)</h6>
                            <h2 class="fw-bold mb-0">
                                ৳ @Model.Sum(x => x.TotalAmountIncludingTaxTk).ToString("N2")
                            </h2>
                        </div>
                        <i class="bi bi-cash-coin fs-1"></i>
                    </div>
                </div>
            </div>
        </div>


        <!-- Total Cost With Tax - RMB -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm bg-dark text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">Cost With Tax (RMB)</h6>
                            <h2 class="fw-bold mb-0">
                                ¥ @Model.Sum(x => x.TotalAmountIncludingTaxRmb).ToString("N2")
                            </h2>
                        </div>
                        <i class="bi bi-currency-yen fs-1"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>
