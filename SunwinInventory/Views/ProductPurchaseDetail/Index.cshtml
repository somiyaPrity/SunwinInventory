    <div class="card-body mt-3">

        @* <div class="purchase-report-table"> *@

        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4 mb-0">
                No purchases found for the selected filters.
            </p>
        }
        else
        {
        <table class="table table-bordered table-striped table-hover" id="purchaseTable">

            <thead class="table-dark">

                <tr>

                    <th>SL</th>

                    <th>Date</th>

                    <th>Shipment</th>

                    <th>Supplier</th>

                    <th>Warehouse</th>

                    <th>Product</th>

                    <th>Color</th>

                    <th>Thickness</th>

                    <th>Size</th>

                    <th class="text-end">Qty</th>

                    <th class="text-end">Weight</th>

                    <th class="text-end">Unit Price</th>

                    <th class="text-end">Total TK</th>

                    <th width="180">Action</th>

                </tr>

            </thead>

            <tbody>
                @* <h3>Total Rows = @Model.Count()</h3> *@
                @{
                    int sl = 1;

                    decimal totalQty = 0;
                    decimal totalWeight = 0;
                    decimal totalTk = 0;
                }

                @foreach (var item in Model)
                {
                    totalQty += item.InitialQuantity;
                    totalWeight += item.TotalWeightKg;
                    totalTk += item.TotalAmountIncludingTaxTk;

                    <tr>

                        <td>@sl</td>

                        <td>@item.CreatedDate.ToString("dd-MMM-yyyy")</td>

                        <td>@item.ShipmentNo</td>

                        <td>@item.SupplierName</td>

                        <td>@item.WarehouseName</td>

                        <td>@item.ProductName</td>

                        <td>@item.ColorName</td>

                        <td>@item.Thickness</td>

                        <td>@item.ProductSize</td>

                        <td class="text-end">@item.InitialQuantity</td>

                        <td class="text-end">@item.TotalWeightKg.ToString("N2")</td>

                        <td class="text-end">@item.UnitPriceTk.ToString("N2")</td>

                        <td class="text-end">@item.TotalAmountIncludingTaxTk.ToString("N2")</td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.ProductPurchaseDetailId"
                               class="btn btn-warning  btn-sm">
                                Edit
                            </a>

                            <button class="btn btn-danger btn-sm w-75 btnDelete"
                                    data-id="@item.ProductPurchaseDetailId">
                                Delete
                            </button>

                        </td>

                    </tr>

                    sl++;
                }

            </tbody>

            <tfoot class="table-secondary">

                <tr>

                    <th colspan="9" class="text-end">
                        Grand Total
                    </th>

                    <th class="text-end">
                        @totalQty
                    </th>

                    <th class="text-end">
                        @totalWeight.ToString("N2")
                    </th>

                    <th></th>

                    <th class="text-end">
                        @totalTk.ToString("N2")
                    </th>

                    <th></th>

                </tr>

            </tfoot>

        </table>
        }

    </div>

</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            $("#purchaseTable").DataTable({

                pageLength: 25,

                lengthMenu: [10, 25, 50, 100],

                scrollX: true,

                scrollCollapse: true,

                autoWidth: false,

                ordering: true,

                searching: true,

                columnDefs: [
                    {
                        targets: "_all",
                        className: "text-nowrap"
                    }
                ]

            });


            $(".btnDelete").click(function () {

                if (!confirm("Delete this purchase?"))
                    return;

                var id = $(this).data("id");

                $.post(
                    "/ProductPurchaseDetail/Delete/" + id,
                    function () {
                        location.reload();
                    }
                );

            });

        });
    </script>

}
