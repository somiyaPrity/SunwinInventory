@model SunwinInventory.DTOs.ProductPurchaseDetail.PurchaseEntryDto

@{
    ViewData["Title"] = "Purchase Entry";
}

<div class="container-fluid">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h4>Purchase Entry</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post" enctype="multipart/form-data" id="purchaseForm">
                @Html.AntiForgeryToken()
              
                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label>Shipment</label>

                        <select asp-for="ShipmentId"
                                asp-items="ViewBag.Shipments"
                                class="form-select"
                                id="ShipmentId">
                            <option value="">Select Shipment</option>
                        </select>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label>Supplier</label>

                        <select asp-for="SupplierId"
                                asp-items="ViewBag.Suppliers"
                                class="form-select"
                                id="SupplierId">

                            <option value="">Select Supplier</option>

                        </select>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label>Warehouse</label>

                        <select asp-for="WarehouseId"
                                asp-items="ViewBag.Warehouses"
                                class="form-select"
                                id="WarehouseId">

                            <option value="">Select Warehouse</option>

                        </select>

                    </div>

                </div>

                <hr/>

                <div class="row">

                    <div class="col-md-8">

                        <label>Upload Excel</label>

                        <input type="file"
                               id="excelFile"
                               class="form-control"
                               accept=".xlsx,.xls"/>

                    </div>

                    <div class="col-md-4 d-flex align-items-end">

                        <button type="button"
                                class="btn btn-success w-100"
                                id="btnUploadExcel">

                            Upload Excel

                        </button>

                    </div>

                </div>

                <hr/>

                <h5 class="text-primary">

                    Individual Purchase Entry

                </h5><div class="row mt-3">

                    <div class="col-md-3 mb-3">
                        <label>Product</label>
                        <select id="ProductNameId" class="form-select">
                            <option value="">Select Product</option>
                            @foreach (var item in ViewBag.Products)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Color</label>
                        <select id="ColorId" class="form-select">
                            <option value="">Select Color</option>
                            @foreach (var item in ViewBag.Colors)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Thickness</label>
                        <input type="number" step="0.01" id="Thickness" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Size</label>
                        <input type="text" id="ProductSize" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Quantity</label>
                        <input type="number" id="InitialQuantity" class="form-control" />
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-2 mb-3">
                        <label>Unit Weight (KG)</label>
                        <input type="number" step="0.0001" id="UnitWeightKg" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Total Weight</label>
                        <input type="number" step="0.0001" id="TotalWeightKg" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Exchange Rate</label>
                        <input type="number" step="0.0001" id="ExchangeRate" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Unit Price TK</label>
                        <input type="number" step="0.0001" id="UnitPriceTk" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Unit Price RMB</label>
                        <input type="number" step="0.0001" id="UnitPriceRmb" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Import Tax TK</label>
                        <input type="number" step="0.0001" id="ImportTaxPerKgTk" class="form-control" />
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-2 mb-3">
                        <label>Import Tax RMB</label>
                        <input type="number" step="0.0001" id="ImportTaxPerKgRmb" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Cost/KG TK</label>
                        <input type="number" step="0.0001" id="CostPriceKgTk" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Cost/LBS TK</label>
                        <input type="number" step="0.0001" id="CostPriceLbsTk" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Cost/PCS TK</label>
                        <input type="number" step="0.0001" id="CostPricePerPieceTk" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Cost/KG RMB</label>
                        <input type="number" step="0.0001" id="CostPriceKgRmb" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Cost/LBS RMB</label>
                        <input type="number" step="0.0001" id="CostPriceLbsRmb" class="form-control" />
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label>Total Without Tax TK</label>
                        <input type="number" step="0.01" id="TotalAmountWithoutTaxTk" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Total With Tax TK</label>
                        <input type="number" step="0.01" id="TotalAmountIncludingTaxTk" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Total Without Tax RMB</label>
                        <input type="number" step="0.01" id="TotalAmountWithoutTaxRmb" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Total With Tax RMB</label>
                        <input type="number" step="0.01" id="TotalAmountIncludingTaxRmb" class="form-control" />
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-10 mb-3">
                        <label>Remarks</label>
                        <input type="text" id="Remarks" class="form-control" />
                    </div>

                    <div class="col-md-1 d-flex align-items-end">

                        <button type="button"
                                class="btn btn-warning w-100"
                                id="btnCalculate">

                            Calculate

                        </button>

                    </div>

                    <div class="col-md-1 d-flex align-items-end">

                        <button type="button"
                                class="btn btn-primary w-100"
                                id="btnAddItem">

                            Add To List

                        </button>

                    </div>

                </div>

                <hr />

                <h5 class="text-success">

                    Purchase Preview

                </h5>

