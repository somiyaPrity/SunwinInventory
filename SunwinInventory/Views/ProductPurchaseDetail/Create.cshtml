                    function RefreshTableSummary() {

                        var sl = 1;

                        var totalQty = 0;
                        var totalWeight = 0;
                        var totalTk = 0;

                        $("#purchaseTable tbody tr").each(function () {

                            $(this).find(".sl").text(sl++);

                            totalQty += parseFloat($(this).find(".qty").text()) || 0;

                            totalWeight += parseFloat($(this).find(".weight").text()) || 0;

                            totalTk += parseFloat($(this).find(".totalTk").text()) || 0;

                        });

                        $("#lblTotalQty").text(totalQty);

                        $("#lblTotalWeight").text(totalWeight.toFixed(3));

                        $("#lblTotalTk").text(totalTk.toFixed(2));
                    }
                    $("#btnAddItem").click(function () {

                        if ($("#ShipmentId").val() == "") {
                            alert("Please Select Shipment.");
                            $("#ShipmentId").focus();
                            return;
                        }

                        if ($("#SupplierId").val() == "") {
                            alert("Please Select Supplier.");
                            $("#SupplierId").focus();
                            return;
                        }

                        if ($("#WarehouseId").val() == "") {
                            alert("Please Select Warehouse.");
                            $("#WarehouseId").focus();
                            return;
                        }

                        if ($("#ProductNameId").val() == "") {
                            alert("Please Select Product.");
                            $("#ProductNameId").focus();
                            return;
                        }

                        if ($("#ColorId").val() == "") {
                            alert("Please Select Color.");
                            $("#ColorId").focus();
                            return;
                        }

                        if ($("#InitialQuantity").val() == "" || $("#InitialQuantity").val() == "0") {
                            alert("Please Enter Quantity.");
                            $("#InitialQuantity").focus();
                            return;
                        }

                        //==============================
                        // Duplicate Check
                        //==============================

                        var duplicate = false;

                        $("#purchaseTable tbody tr").each(function () {

                            var p = $(this).find("input[name$='.ProductNameId']").val();
                            var c = $(this).find("input[name$='.ColorId']").val();
                            var t = $(this).find("input[name$='.Thickness']").val();
                            var s = $(this).find("input[name$='.ProductSize']").val();

                            if (
                                p == $("#ProductNameId").val() &&
                                c == $("#ColorId").val() &&
                                t == $("#Thickness").val() &&
                                s == $("#ProductSize").val()
                            ) {
                                duplicate = true;
                                return false;
                            }

                        });

                        if (duplicate) {
                            alert("This product already exists in the list.");
                            return;
                        }

                        var productText = $("#ProductNameId option:selected").text();
                        var colorText = $("#ColorId option:selected").text();

                        var totalTk = parseFloat($("#TotalAmountIncludingTaxTk").val() || 0);

                        var html = "";

                        html += "<tr>";

                        html += "<td class='sl'></td>";
                        html += "<td>" + productText + "</td>";
                        html += "<td>" + colorText + "</td>";
                        html += "<td>" + $("#Thickness").val() + "</td>";
                        html += "<td>" + $("#ProductSize").val() + "</td>";
                        html += "<td class='qty'>" + $("#InitialQuantity").val() + "</td>";
                        html += "<td class='weight'>" + $("#TotalWeightKg").val() + "</td>";
                        html += "<td>" + $("#UnitPriceTk").val() + "</td>";
                        html += "<td class='totalTk'>" + totalTk.toFixed(2) + "</td>";

                        html += "<td>";
                        html += "<button type='button' class='btn btn-danger btn-sm btnRemove'>Remove</button>";
                        html += "</td>";

                        //==============================
                        // Hidden Inputs
                        //==============================

                        html += Hidden(rowIndex, "ShipmentId", $("#ShipmentId").val());
                        html += Hidden(rowIndex, "SupplierId", $("#SupplierId").val());
                        html += Hidden(rowIndex, "WarehouseId", $("#WarehouseId").val());

                        html += Hidden(rowIndex, "ProductNameId", $("#ProductNameId").val());
                        html += Hidden(rowIndex, "ColorId", $("#ColorId").val());

                        html += Hidden(rowIndex, "Thickness", $("#Thickness").val());
                        html += Hidden(rowIndex, "ProductSize", $("#ProductSize").val());

                        html += Hidden(rowIndex, "InitialQuantity", $("#InitialQuantity").val());

                        html += Hidden(rowIndex, "UnitWeightKg", $("#UnitWeightKg").val());
                        html += Hidden(rowIndex, "TotalWeightKg", $("#TotalWeightKg").val());

                        html += Hidden(rowIndex, "ExchangeRate", $("#ExchangeRate").val());

                        html += Hidden(rowIndex, "UnitPriceTk", $("#UnitPriceTk").val());
                        html += Hidden(rowIndex, "UnitPriceRmb", $("#UnitPriceRmb").val());

                        html += Hidden(rowIndex, "ImportTaxPerKgTk", $("#ImportTaxPerKgTk").val());
                        html += Hidden(rowIndex, "ImportTaxPerKgRmb", $("#ImportTaxPerKgRmb").val());

                        html += Hidden(rowIndex, "CostPriceKgTk", $("#CostPriceKgTk").val());
                        html += Hidden(rowIndex, "CostPriceLbsTk", $("#CostPriceLbsTk").val());
                        html += Hidden(rowIndex, "CostPricePerPieceTk", $("#CostPricePerPieceTk").val());

                        html += Hidden(rowIndex, "CostPriceKgRmb", $("#CostPriceKgRmb").val());
                        html += Hidden(rowIndex, "CostPriceLbsRmb", $("#CostPriceLbsRmb").val());
                        html += Hidden(rowIndex, "CostPricePcsRmb", $("#CostPricePcsRmb").val());

                        html += Hidden(rowIndex, "TotalAmountWithoutTaxTk", $("#TotalAmountWithoutTaxTk").val());
                        html += Hidden(rowIndex, "TotalAmountIncludingTaxTk", $("#TotalAmountIncludingTaxTk").val());

                        html += Hidden(rowIndex, "TotalAmountWithoutTaxRmb", $("#TotalAmountWithoutTaxRmb").val());
                        html += Hidden(rowIndex, "TotalAmountIncludingTaxRmb", $("#TotalAmountIncludingTaxRmb").val());

                        html += Hidden(rowIndex, "Remarks", $("#Remarks").val());

                        html += "</tr>";

                        $("#purchaseTable tbody").append(html);

                        rowIndex++;

                        RefreshTableSummary();
                        //==============================
                        // Clear Entry Form
                        //==============================

                        $("#ProductNameId").val("");
                        $("#ColorId").val("");

                        $("#Thickness").val("");
                        $("#ProductSize").val("");
                        $("#InitialQuantity").val("");

                        $("#UnitWeightKg").val("");
                        $("#TotalWeightKg").val("");

                        $("#ExchangeRate").val("");

                        $("#UnitPriceTk").val("");
                        $("#UnitPriceRmb").val("");

                        $("#ImportTaxPerKgTk").val("");
