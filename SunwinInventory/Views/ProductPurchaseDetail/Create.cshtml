    @section Scripts {

        @* excel entry *@
        <script>

            $("#btnUpload").click(function () {

                var shipmentId = $("#ShipmentId").val();
                var supplierId = $("#SupplierId").val();
                var warehouseId = $("#WarehouseId").val();

                if (shipmentId == "") {
                    alert("Select Shipment");
                    return;
                }

                if (supplierId == "") {
                    alert("Select Supplier");
                    return;
                }

                if (warehouseId == "") {
                    alert("Select Warehouse");
                    return;
                }

                if ($("#excelFile")[0].files.length == 0) {
                    alert("Select Excel File");
                    return;
                }

                var file = $("#excelFile")[0].files[0];

                var data = new FormData();

                data.append("file", file);
                data.append("shipmentId", shipmentId);
                data.append("supplierId", supplierId);
                data.append("warehouseId", warehouseId);

                $.ajax({

                    url: "/ProductPurchaseDetail/UploadExcel",

                    type: "POST",

                    data: data,

                    processData: false,

                    contentType: false,

                    // success: function (response) {

                    //     purchaseItems = response;

                    //     renderTable();

                    //     $("#PreviewArea").show();

                    //     $("#btnSave").show();
                    //     console.log(response);

                    //     renderExcel(response);

                    // },
                    success: function (response) {

                        purchaseItems = response.map(function (x) {

                            return {

                                ShipmentId: x.shipmentId,
                                SupplierId: x.supplierId,
                                WarehouseId: x.warehouseId,

                                ProductNameId: x.productNameId,
                                ProductName: x.productName,

                                ColorId: x.colorId,
                                ColorName: x.colorName,

                                Thickness: x.thickness,
                                ProductSize: x.productSize,

                                InitialQuantity: x.initialQuantity,

                                UnitWeightKg: x.unitWeightKg,
                                TotalWeightKg: x.totalWeightKg,

                                ExchangeRate: x.exchangeRate,

                                UnitPriceRmb: x.unitPriceRmb,
                                UnitPriceTk: x.unitPriceTk,

                                ImportTaxPerKgTk: x.importTaxPerKgTk,
                                ImportTaxPerKgRmb: x.importTaxPerKgRmb,

                                CostPriceKgTk: x.costPriceKgTk,
                                CostPriceLbsTk: x.costPriceLbsTk,
                                CostPricePcsTk: x.costPricePcsTk,
                                CostPricePcsRmb: x.costPricePcsRmb,

                                CostPriceKgRmb: x.costPriceKgRmb,
                                CostPriceLbsRmb: x.costPriceLbsRmb,

                                TotalAmountWithoutTaxTk: x.totalAmountWithoutTaxTk,
                                TotalAmountIncludingTaxTk: x.totalAmountIncludingTaxTk,

                                TotalAmountWithoutTaxRmb: x.totalAmountWithoutTaxRmb,
                                TotalAmountIncludingTaxRmb: x.totalAmountIncludingTaxRmb,

                                Remarks: x.remarks

                            };

                        });

                        renderTable();

                        $("#btnSave").prop("disabled", purchaseItems.length == 0);
                    },
                    error: function (xhr) {

                        alert(xhr.responseText);

                    }

                });

            });
            function renderExcel(items) {

                purchaseItems = [];

                items.forEach(function (item) {

                    purchaseItems.push(item);

                });

                renderTable();

                $("#btnSave").prop("disabled", purchaseItems.length == 0);

            }
        </script>

        @* individual entry *@
        <script>
            let editIndex = -1;
            let purchaseItems = [];
            $(document).ready(function () {

                CalculatePurchase();

            });
            $("#btnSave").prop("disabled", true);
            $("#btnCalculate").click(function () {

                CalculatePurchase();

            });
            
          
            $("#InitialQuantity").on("keyup change", calculatePurchase);

            $("#TotalWeightKg").on("keyup change", calculatePurchase);

            $("#ExchangeRate").on("keyup change", calculatePurchase);

            $("#UnitPriceRmb").on("keyup change", calculatePurchase);

            $("#ImportTaxPerKgTk").on("keyup change", calculatePurchase);
            function calculatePurchase() {

                var qty = parseFloat($("#InitialQuantity").val()) || 0;

                var totalWeight = parseFloat($("#TotalWeightKg").val()) || 0;

                var exchangeRate = parseFloat($("#ExchangeRate").val()) || 0;

                var unitPriceRmb = parseFloat($("#UnitPriceRmb").val()) || 0;

                var taxPerKgTk = parseFloat($("#ImportTaxPerKgTk").val()) || 0;

                // If RMB tax is editable, read it.
                // Otherwise keep automatic conversion.
                // var taxPerKgRmb = parseFloat($("#ImportTaxPerKgRmb").val());
                var taxPerKgRmb = exchangeRate > 0
                    ? taxPerKgTk / exchangeRate
                    : 0;

                $("#ImportTaxPerKgRmb").val(taxPerKgRmb.toFixed(2));
                if (isNaN(taxPerKgRmb))
                    taxPerKgRmb = exchangeRate > 0 ? taxPerKgTk / exchangeRate : 0;

                //----------------------------------------------------
                // Unit Weight
                //----------------------------------------------------

                var unitWeight = qty > 0 ? totalWeight / qty : 0;

                $("#UnitWeightKg").val(unitWeight.toFixed(4));

                //----------------------------------------------------
                // Unit Price
                //----------------------------------------------------

                // Keep full precision
                var unitPriceTk = unitPriceRmb * exchangeRate;

                $("#UnitPriceTk").val(unitPriceTk.toFixed(2));

                //----------------------------------------------------
                // Import Tax
                //----------------------------------------------------

                $("#ImportTaxPerKgRmb").val(taxPerKgRmb.toFixed(2));

                //----------------------------------------------------
                // Cost Price / KG
                //----------------------------------------------------

                var costKgTk = unitPriceTk + taxPerKgTk;

                $("#CostPriceKgTk").val(costKgTk.toFixed(2));

                // Excel formula
                var costKgRmb = unitPriceRmb + taxPerKgRmb;

                $("#CostPriceKgRmb").val(costKgRmb.toFixed(2));

                //----------------------------------------------------
                // Cost Price / LBS
                //----------------------------------------------------

                var costLbsTk = costKgTk / 2.20462;

                $("#CostPriceLbsTk").val(costLbsTk.toFixed(2));

                var costLbsRmb = costKgRmb / 2.20462;

                $("#CostPriceLbsRmb").val(costLbsRmb.toFixed(2));

                //----------------------------------------------------
                // Cost Price / PCS
                //----------------------------------------------------

                var costPieceTk = costKgTk * unitWeight;

                $("#CostPricePcsTk").val(costPieceTk.toFixed(2));

                var costPieceRmb = costKgRmb * unitWeight;

                $("#CostPricePcsRmb").val(costPieceRmb.toFixed(2));

                //----------------------------------------------------
                // Total Without Tax
                //----------------------------------------------------

                var totalWithoutTaxTk = totalWeight * unitPriceTk;

                $("#TotalAmountWithoutTaxTk").val(totalWithoutTaxTk.toFixed(2));

                var totalWithoutTaxRmb = totalWeight * unitPriceRmb;

                $("#TotalAmountWithoutTaxRmb").val(totalWithoutTaxRmb.toFixed(2));

                //----------------------------------------------------
                // Total With Tax
                //----------------------------------------------------

                var totalWithTaxTk = totalWeight * costKgTk;

                $("#TotalAmountIncludingTaxTk").val(totalWithTaxTk.toFixed(2));

                // Excel appears to use 16.95 rather than the transaction rate
                var totalWithTaxRmb = totalWithTaxTk / 16.95;

                $("#TotalAmountIncludingTaxRmb").val(totalWithTaxRmb.toFixed(2));

                //----------------------------------------------------
                // Import Tax Applied
                //----------------------------------------------------

                var importTaxApplied = totalWithTaxTk - totalWithoutTaxTk;

                $("#ImportTaxApplied").val(importTaxApplied.toFixed(2));

            }

            function editRow(index) {

                editIndex = index;

                var item = purchaseItems[index];

                $("#SupplierId").val(item.SupplierId);

                $("#WarehouseId").val(item.WarehouseId);

                $("#ProductNameId").val(item.ProductNameId);

                $("#ColorId").val(item.ColorId);

                $("#Thickness").val(item.Thickness);

                $("#ProductSize").val(item.ProductSize);

                $("#InitialQuantity").val(item.InitialQuantity);

                $("#UnitWeightKg").val(item.UnitWeightKg);

                $("#TotalWeightKg").val(item.TotalWeightKg);

                $("#ExchangeRate").val(item.ExchangeRate);

                $("#UnitPriceRmb").val(item.UnitPriceRmb);

                $("#UnitPriceTk").val(item.UnitPriceTk);

                $("#ImportTaxPerKgTk").val(item.ImportTaxPerKgTk);

                $("#ImportTaxPerKgRmb").val(item.ImportTaxPerKgRmb);

                $("#CostPriceKgTk").val(item.CostPriceKgTk);

                $("#CostPriceKgRmb").val(item.CostPriceKgRmb);

                $("#CostPriceLbsTk").val(item.CostPriceLbsTk);

                $("#CostPriceLbsRmb").val(item.CostPriceLbsRmb);

                $("#CostPricePcsTk").val(item.CostPricePcsTk);

                $("#CostPricePcsRmb").val(item.CostPricePcsRmb);

                $("#TotalAmountWithoutTaxTk").val(item.TotalAmountWithoutTaxTk);

                $("#TotalAmountWithoutTaxRmb").val(item.TotalAmountWithoutTaxRmb);

                $("#TotalAmountIncludingTaxTk").val(item.TotalAmountIncludingTaxTk);

                $("#TotalAmountIncludingTaxRmb").val(item.TotalAmountIncludingTaxRmb);

                $("#Remarks").val(item.Remarks);

                $("html,body").animate({
                    scrollTop: $("#SupplierId").offset().top - 100
                }, 300);

            }
           
            $("#InitialQuantity,#TotalWeightKg,#ExchangeRate,#UnitPriceRmb,#ImportTaxPerKgTk")
                .on("keyup change", function () {

                    $("#btnCalculate").click();

                });

            $("#btnAdd").click(function () {

                if ($("#ShipmentId").val() == "") {

                    Swal.fire("Warning", "Please select Shipment.", "warning");
                    return;
                }

                if ($("#SupplierId").val() == "") {

                    alert("Select Supplier");
                    return;
                }

                if ($("#WarehouseId").val() == "") {

                    alert("Select Warehouse");
                    return;
                }

                if ($("#ProductNameId").val() == "") {

                    alert("Select Product");
                    return;
                }

                if ($("#ColorId").val() == "") {

                    alert("Select Color");
                    return;
                }

                let item = {

                    ShipmentId: $("#ShipmentId").val(),

                    SupplierId: $("#SupplierId").val(),
                    SupplierName: $("#SupplierId option:selected").text(),

                    WarehouseId: $("#WarehouseId").val(),
                    WarehouseName: $("#WarehouseId option:selected").text(),

                    ProductNameId: $("#ProductNameId").val(),
                    ProductName: $("#ProductNameId option:selected").text(),

                    ColorId: $("#ColorId").val(),
                    ColorName: $("#ColorId option:selected").text(),

                    Thickness: $("#Thickness").val(),
                    ProductSize: $("#ProductSize").val(),

                    InitialQuantity: $("#InitialQuantity").val(),

                    UnitWeightKg: $("#UnitWeightKg").val(),

                    TotalWeightKg: $("#TotalWeightKg").val(),

                    ExchangeRate: $("#ExchangeRate").val(),

                    UnitPriceRmb: $("#UnitPriceRmb").val(),

                    UnitPriceTk: $("#UnitPriceTk").val(),

                    ImportTaxPerKgTk: $("#ImportTaxPerKgTk").val(),

                    ImportTaxPerKgRmb: $("#ImportTaxPerKgRmb").val(),
                    CostPricePcsTk: $("#CostPricePcsTk").val(),
                    CostPricePcsRmb: $("#CostPricePcsRmb").val(),
                    CostPriceKgTk: $("#CostPriceKgTk").val(),

                    CostPriceLbsTk: $("#CostPriceLbsTk").val(),

                    CostPriceKgRmb: $("#CostPriceKgRmb").val(),

                    CostPriceLbsRmb: $("#CostPriceLbsRmb").val(),

                    TotalAmountWithoutTaxTk: $("#TotalAmountWithoutTaxTk").val(),

                    TotalAmountIncludingTaxTk: $("#TotalAmountIncludingTaxTk").val(),

                    TotalAmountWithoutTaxRmb: $("#TotalAmountWithoutTaxRmb").val(),

                    TotalAmountIncludingTaxRmb: $("#TotalAmountIncludingTaxRmb").val(),

                    Remarks: $("#Remarks").val()

                };

                let exists = purchaseItems.some(x =>

                    x.ProductNameId == item.ProductNameId &&
                    x.ColorId == item.ColorId &&
                    x.Thickness == item.Thickness &&
                    x.ProductSize == item.ProductSize

                );

                if (editIndex == -1) {

                    purchaseItems.push(item);

                }
                else {

                    purchaseItems[editIndex] = item;

                    editIndex = -1;

                }

                $("#btnSave").prop("disabled", false);

                renderTable();

                updateFooter();

                $("#ItemsJson").val(JSON.stringify(purchaseItems));

                clearEntry();
            });

            function renderTable() {

                let tbody = $("#purchaseTable tbody");

                let hidden = $("#hiddenItems");

                tbody.empty();

                hidden.empty();

                purchaseItems.forEach(function (item, index) {

                    tbody.append(`

            <tr>

            <td>${index + 1}</td>

            <td>${item.ProductName}</td>

            <td>${item.ColorName}</td>

            <td>${item.Thickness}</td>

            <td>${item.ProductSize}</td>

            <td>${item.InitialQuantity}</td>

            <td>${item.TotalWeightKg}</td>

            <td>${item.UnitPriceRmb}</td>

            <td>${item.TotalAmountIncludingTaxTk}</td>

                        <td>
                <button type="button"
                        class="btn btn-warning btn-sm"
                        onclick="editRow(${index})">
                    <i class="bi bi-pencil"></i>
                </button>

                <button type="button"
                        class="btn btn-danger btn-sm"
                        onclick="deleteRow(${index})">
                    <i class="bi bi-trash"></i>
                </button>
            </td>

            </tr>

            `);

                    hidden.append(`

            <input type="hidden" name="Items[${index}].ShipmentId" value="${item.ShipmentId}" />
                        <input type="hidden" name="Items[${index}].SupplierId" value="${item.SupplierId}" />

            <input type="hidden" name="Items[${index}].WarehouseId" value="${item.WarehouseId}" />

            <input type="hidden" name="Items[${index}].ProductNameId" value="${item.ProductNameId}" />

            <input type="hidden" name="Items[${index}].ColorId" value="${item.ColorId}" />

            <input type="hidden" name="Items[${index}].Thickness" value="${item.Thickness}" />

            <input type="hidden" name="Items[${index}].ProductSize" value="${item.ProductSize}" />

            <input type="hidden" name="Items[${index}].InitialQuantity" value="${item.InitialQuantity}" />

            <input type="hidden" name="Items[${index}].UnitWeightKg" value="${item.UnitWeightKg}" />

            <input type="hidden" name="Items[${index}].TotalWeightKg" value="${item.TotalWeightKg}" />

            <input type="hidden" name="Items[${index}].ExchangeRate" value="${item.ExchangeRate}" />

            <input type="hidden" name="Items[${index}].UnitPriceRmb" value="${item.UnitPriceRmb}" />

            <input type="hidden" name="Items[${index}].UnitPriceTk" value="${item.UnitPriceTk}" />

            <input type="hidden" name="Items[${index}].ImportTaxPerKgTk" value="${item.ImportTaxPerKgTk}" />

            <input type="hidden" name="Items[${index}].ImportTaxPerKgRmb" value="${item.ImportTaxPerKgRmb}" />

            <input type="hidden" name="Items[${index}].CostPriceKgTk" value="${item.CostPriceKgTk}" />

            <input type="hidden" name="Items[${index}].CostPriceLbsTk" value="${item.CostPriceLbsTk}" />
            <input type="hidden" name="Items[${index}].CostPricePcsTk"
                   value="${item.CostPricePcsTk}" />
                                     <input type="hidden" name="Items[${index}].CostPricePcsRmb"
                                           value="${item.CostPricePcsRmb}" />

            <input type="hidden" name="Items[${index}].CostPriceKgRmb" value="${item.CostPriceKgRmb}" />

            <input type="hidden" name="Items[${index}].CostPriceLbsRmb" value="${item.CostPriceLbsRmb}" />

            <input type="hidden" name="Items[${index}].TotalAmountWithoutTaxTk" value="${item.TotalAmountWithoutTaxTk}" />

            <input type="hidden" name="Items[${index}].TotalAmountIncludingTaxTk" value="${item.TotalAmountIncludingTaxTk}" />

            <input type="hidden" name="Items[${index}].TotalAmountWithoutTaxRmb" value="${item.TotalAmountWithoutTaxRmb}" />

            <input type="hidden" name="Items[${index}].TotalAmountIncludingTaxRmb" value="${item.TotalAmountIncludingTaxRmb}" />

            <input type="hidden" name="Items[${index}].Remarks" value="${item.Remarks}" />

            `);

                });

                calculateGrandTotal();

            }

            function calculateGrandTotal() {

                let tk = 0;

                let rmb = 0;

                purchaseItems.forEach(function (item) {

                    tk += parseFloat(item.TotalAmountIncludingTaxTk) || 0;

                    rmb += parseFloat(item.TotalAmountIncludingTaxRmb) || 0;

                });

                $("#grandTk").text(tk.toFixed(2));

                $("#grandRmb").text(rmb.toFixed(2));

            }

          
            function deleteRow(index) {

                purchaseItems.splice(index, 1);

                renderTable();

            }
         
            function clearEntry() {

                $("#SupplierId").val("");

                $("#WarehouseId").val("");

                $("#ProductNameId").val("");

                $("#ColorId").val("");

                $("#Thickness").val("");

                $("#ProductSize").val("");

                $("#InitialQuantity").val("");

                $("#UnitWeightKg").val("");

                $("#TotalWeightKg").val("");

                $("#ExchangeRate").val("");

                $("#UnitPriceRmb").val("");

                $("#UnitPriceTk").val("");

                $("#ImportTaxPerKgTk").val("");

                $("#ImportTaxPerKgRmb").val("");

                $("#CostPriceKgTk").val("");

                $("#CostPriceLbsTk").val("");

                $("#CostPricePerPieceTk").val("");

                $("#CostPriceKgRmb").val("");

                $("#CostPriceLbsRmb").val("");

                $("#TotalAmountWithoutTaxTk").val("");

                $("#TotalAmountWithoutTaxRmb").val("");

                $("#TotalAmountIncludingTaxTk").val("");

                $("#TotalAmountIncludingTaxRmb").val("");

                $("#Remarks").val("");

                $("#SupplierId").focus();


            }
            $("#ShipmentId").change(function () {

                var id = $(this).val();

                if (id == "") {
                    $("#ShipmentDate").val("");
                    return;
                }

                $.get("/Shipment/GetShipment", { id: id }, function (data) {

                    $("#ShipmentDate").val(data.shipmentDate);

                });

            });

            function updateFooter() {

                let qty = 0;

                let weight = 0;

                let amount = 0;

                purchaseItems.forEach(function (x) {

                    qty += Number(x.InitialQuantity);

                    weight += Number(x.TotalWeightKg);

                    amount += Number(x.TotalAmountIncludingTaxTk);

                });

                $("#ftQty").text(qty);

                $("#ftWeight").text(weight.toFixed(2));

                $("#ftAmount").text(amount.toFixed(2));

            }
                </script>

    }
