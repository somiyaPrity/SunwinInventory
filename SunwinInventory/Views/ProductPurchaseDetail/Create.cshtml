                    $("#btnUploadExcel").click(function () {

                        if ($("#ShipmentId").val() == "") {
                            alert("Please Select Shipment.");
                            $("#ShipmentId").focus();
                            return;
                        }

                        if ($("#SupplierId").val() == "") {
                            alert("Please Select Supplier.");
                            $("#SupplierId").focus();
                            return;
                        }

                        if ($("#WarehouseId").val() == "") {
                            alert("Please Select Warehouse.");
                            $("#WarehouseId").focus();
                            return;
                        }

                        var file = $("#excelFile")[0].files[0];

                        if (!file) {
                            alert("Select Excel File");
                            return;
                        }

                        var fd = new FormData();

                        fd.append("file", file);
                        fd.append("shipmentId", $("#ShipmentId").val());
                        fd.append("supplierId", $("#SupplierId").val());
                        fd.append("warehouseId", $("#WarehouseId").val());

                        $.ajax({

                            url: "/ProductPurchaseDetail/UploadExcel",
                            type: "POST",
                            data: fd,
                            processData: false,
                            contentType: false,

                            success: function (result) {

                                $.each(result, function (i, item) {

                                    //==========================
                                    // Duplicate Check
                                    //==========================

                                    var duplicate = false;

                                    $("#purchaseTable tbody tr").each(function () {

                                        var p = $(this).find("input[name$='.ProductNameId']").val();
                                        var c = $(this).find("input[name$='.ColorId']").val();
                                        var t = $(this).find("input[name$='.Thickness']").val();
                                        var s = $(this).find("input[name$='.ProductSize']").val();

                                        if (
                                            p == item.productNameId &&
                                            c == item.colorId &&
                                            t == item.thickness &&
                                            s == item.productSize
                                        ) {
                                            duplicate = true;
                                            return false;
                                        }

                                    });

                                    if (duplicate)
                                        return;

                                    var html = "";

                                    html += "<tr>";

                                    html += "<td class='sl'></td>";
                                    html += "<td>" + item.productName + "</td>";
                                    html += "<td>" + item.colorName + "</td>";
                                    html += "<td>" + item.thickness + "</td>";
                                    html += "<td>" + item.productSize + "</td>";
                                    html += "<td class='qty'>" + item.initialQuantity + "</td>";
                                    html += "<td class='weight'>" + item.totalWeightKg + "</td>";
                                    html += "<td>" + item.unitPriceTk + "</td>";
                                    html += "<td class='totalTk'>" + item.totalAmountIncludingTaxTk + "</td>";

                                    html += "<td>";
                                    html += "<button type='button' class='btn btn-danger btn-sm btnRemove'>Remove</button>";
                                    html += "</td>";

                                    //==========================
                                    // Hidden Inputs
                                    //==========================

                                    html += Hidden(rowIndex, "ShipmentId", item.shipmentId);
                                    html += Hidden(rowIndex, "SupplierId", item.supplierId);
                                    html += Hidden(rowIndex, "WarehouseId", item.warehouseId);

                                    html += Hidden(rowIndex, "ProductNameId", item.productNameId);
                                    html += Hidden(rowIndex, "ColorId", item.colorId);

                                    html += Hidden(rowIndex, "Thickness", item.thickness);
                                    html += Hidden(rowIndex, "ProductSize", item.productSize);

                                    html += Hidden(rowIndex, "InitialQuantity", item.initialQuantity);

                                    html += Hidden(rowIndex, "UnitWeightKg", item.unitWeightKg);
                                    html += Hidden(rowIndex, "TotalWeightKg", item.totalWeightKg);

                                    html += Hidden(rowIndex, "ExchangeRate", item.exchangeRate);

                                    html += Hidden(rowIndex, "UnitPriceTk", item.unitPriceTk);
                                    html += Hidden(rowIndex, "UnitPriceRmb", item.unitPriceRmb);

                                    html += Hidden(rowIndex, "ImportTaxPerKgTk", item.importTaxPerKgTk);
                                    html += Hidden(rowIndex, "ImportTaxPerKgRmb", item.importTaxPerKgRmb);

                                    html += Hidden(rowIndex, "CostPriceKgTk", item.costPriceKgTk);
                                    html += Hidden(rowIndex, "CostPriceLbsTk", item.costPriceLbsTk);
                                    html += Hidden(rowIndex, "CostPricePerPieceTk", item.costPricePerPieceTk);

                                    html += Hidden(rowIndex, "CostPriceKgRmb", item.costPriceKgRmb);
                                    html += Hidden(rowIndex, "CostPriceLbsRmb", item.costPriceLbsRmb);
                                    html += Hidden(rowIndex, "CostPricePcsRmb", item.costPricePcsRmb);

                                    html += Hidden(rowIndex, "TotalAmountWithoutTaxTk", item.totalAmountWithoutTaxTk);
                                    html += Hidden(rowIndex, "TotalAmountIncludingTaxTk", item.totalAmountIncludingTaxTk);

                                    html += Hidden(rowIndex, "TotalAmountWithoutTaxRmb", item.totalAmountWithoutTaxRmb);
                                    html += Hidden(rowIndex, "TotalAmountIncludingTaxRmb", item.totalAmountIncludingTaxRmb);

                                    html += Hidden(rowIndex, "Remarks", item.remarks);

                                    html += "</tr>";

                                    $("#purchaseTable tbody").append(html);

                                    rowIndex++;

                                });

                                RefreshTableSummary();

                                alert("Excel Loaded Successfully.");

                            },

                            error: function () {
                                alert("Excel Upload Failed.");
                            }

                        });

                    });
                 
                    </script>

                }
