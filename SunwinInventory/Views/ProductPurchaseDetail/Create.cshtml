@model SunwinInventory.DTOs.ProductPurchaseDetail.PurchaseEntryDto

@{
    ViewData["Title"] = "Purchase Entry";
}

<div class="container-fluid">
    @* excel upload *@
    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                <i class="bi bi-file-earmark-excel"></i>
                Purchase Entry (Excel Upload)
            </h4>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3 mb-3">

                    <label class="form-label">Shipment</label>

                    <select asp-for="ShipmentId"
                            asp-items="ViewBag.Shipments"
                            id="ShipmentId"
                            class="form-select">

                        <option value="">Select Shipment</option>

                    </select>

                </div>

                <div class="col-md-3 mb-3">

                    <label class="form-label">Supplier</label>

                    <select id="SupplierId"
                            class="form-select"
                            asp-items="ViewBag.Suppliers">

                        <option value="">Select Supplier</option>

                    </select>

                </div>

                <div class="col-md-3 mb-3">

                    <label class="form-label">Warehouse</label>

                    <select id="WarehouseId"
                            class="form-select"
                            asp-items="ViewBag.Warehouses">

                        <option value="">Select Warehouse</option>

                    </select>

                </div>

                <div class="col-md-3 mb-3">

                    <label class="form-label">Excel File</label>

                    <input type="file"
                           id="excelFile"
                           class="form-control"
                           accept=".xlsx,.xls" />

                </div>

            </div>

            <div class="row">

                <div class="col-md-12 text-end">

                    <button type="button"
                            id="btnUpload"
                            class="btn btn-success">

                        <i class="bi bi-upload"></i>

                        Upload Excel

                    </button>

                </div>

            </div>

        </div>

    </div>

<br />

<div id="PreviewArea" style="display:none;">

    <div class="card">

        <div class="card-header bg-success text-white">

            Purchase Preview

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-sm"
                       id="previewTable">

                    <thead>

                    <tr>

                        <th>#</th>

                        <th>Product</th>

                        <th>Color</th>

                        <th>Thickness</th>

                        <th>Size</th>

                        <th>Qty</th>

                        <th>Total Weight</th>

                        <th>Unit Price RMB</th>

                        <th>Total TK</th>

                    </tr>

                    </thead>

                    <tbody></tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<form asp-action="SaveExcelPurchase"
      method="post">

    <input asp-for="ShipmentId" type="hidden" id="hdShipmentId"/>

    <div id="hiddenItems"></div>

    <button class="btn btn-primary mt-3"
            id="btnSave"
            style="display:none">

        Save All

    </button>

</form>
    @* individual entry *@
