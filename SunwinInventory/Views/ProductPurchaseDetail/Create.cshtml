                        $("#CostPriceKgTk").val("");
                        $("#CostPriceLbsTk").val("");
                        $("#CostPricePerPieceTk").val("");

                        $("#CostPriceKgRmb").val("");
                        $("#CostPriceLbsRmb").val("");
                        $("#CostPricePcsRmb").val("");

                        $("#TotalAmountWithoutTaxTk").val("");
                        $("#TotalAmountIncludingTaxTk").val("");

                        $("#TotalAmountWithoutTaxRmb").val("");
                        $("#TotalAmountIncludingTaxRmb").val("");

                        $("#Remarks").val("");

                        $("#ProductNameId").focus();

                    });

                        //===========================================
                        // REMOVE
                        //===========================================

                    $(document).on("click", ".btnRemove", function () {

                        $(this).closest("tr").remove();

                        RefreshTableSummary();

                    });

                        //===========================================
