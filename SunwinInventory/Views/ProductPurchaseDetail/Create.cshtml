                    </button>

                </div>
              </form>
                
                @section Scripts {

                    <script>

                        let rowIndex = 0;
                 

                 
                        //===========================================
                        // ADD INDIVIDUAL ITEM
                        //===========================================
                    function n(id) {

                        return parseFloat($(id).val()) || 0;

                    }

                    function CalculatePurchase() {

                        var qty = n("#InitialQuantity");

                        var unitWeight = n("#UnitWeightKg");

                        var exRate = n("#ExchangeRate");

                        var unitPriceTk = n("#UnitPriceTk");

                        var unitPriceRmb = n("#UnitPriceRmb");

                        var taxTk = n("#ImportTaxPerKgTk");

                        //-------------------------------------------------

                        var totalWeight = qty * unitWeight;

                        $("#TotalWeightKg").val(totalWeight.toFixed(4));

                        //-------------------------------------------------

                        if (unitPriceTk == 0 && unitPriceRmb > 0 && exRate > 0) {

                            unitPriceTk = unitPriceRmb * exRate;

                            $("#UnitPriceTk").val(unitPriceTk.toFixed(4));

                        }

                        if (unitPriceRmb == 0 && unitPriceTk > 0 && exRate > 0) {

                            unitPriceRmb = unitPriceTk / exRate;

                            $("#UnitPriceRmb").val(unitPriceRmb.toFixed(4));

                        }

                        //-------------------------------------------------

                        var costKgTk = unitPriceTk + taxTk;

                        $("#CostPriceKgTk").val(costKgTk.toFixed(4));

                        //-------------------------------------------------

                        var costLbsTk = costKgTk / 2.20462;

                        $("#CostPriceLbsTk").val(costLbsTk.toFixed(4));

                        //-------------------------------------------------

                        var costPieceTk = qty == 0 ? 0 : (costKgTk * totalWeight) / qty;

                        $("#CostPricePerPieceTk").val(costPieceTk.toFixed(4));

                        //-------------------------------------------------

                        var costKgRmb = exRate == 0 ? 0 : costKgTk / exRate;

                        $("#CostPriceKgRmb").val(costKgRmb.toFixed(4));

                        //-------------------------------------------------

                        var costLbsRmb = exRate == 0 ? 0 : costLbsTk / exRate;

                        $("#CostPriceLbsRmb").val(costLbsRmb.toFixed(4));

                        //-------------------------------------------------

                        var costPieceRmb = exRate == 0 ? 0 : costPieceTk / exRate;

                        $("#CostPricePcsRmb").val(costPieceRmb.toFixed(4));

                        //-------------------------------------------------

                        var withoutTaxTk = unitPriceTk * totalWeight;

                        $("#TotalAmountWithoutTaxTk").val(withoutTaxTk.toFixed(2));

                        //-------------------------------------------------

                        var withTaxTk = costKgTk * totalWeight;

                        $("#TotalAmountIncludingTaxTk").val(withTaxTk.toFixed(2));

                        //-------------------------------------------------

                        var withoutTaxRmb = exRate == 0 ? 0 : withoutTaxTk / exRate;

                        $("#TotalAmountWithoutTaxRmb").val(withoutTaxRmb.toFixed(2));

                        //-------------------------------------------------

                        var withTaxRmb = exRate == 0 ? 0 : withTaxTk / exRate;

                        $("#TotalAmountIncludingTaxRmb").val(withTaxRmb.toFixed(2));

                    } $("#btnCalculate").click(function () {

                        CalculatePurchase();

                    }); $("#InitialQuantity,#UnitWeightKg,#ExchangeRate,#UnitPriceTk,#UnitPriceRmb,#ImportTaxPerKgTk")
                        .on("keyup change", function () {

                            CalculatePurchase();

                        });
