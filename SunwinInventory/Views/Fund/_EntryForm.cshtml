@model SunwinInventory.DTOs.Fund.FundEntryDto

@{
    var heads = ViewBag.Heads as List<SelectListItem>
        ?? new List<SelectListItem>();

    var accounts = ViewBag.Accounts as List<SelectListItem>
        ?? new List<SelectListItem>();

    var openingDate = ViewBag.OpeningDate is DateTime od
        ? od
        : new DateTime(2026, 6, 1);
}

<div class="row g-3">

    <div class="col-md-4">

        <label asp-for="EntryDate" class="form-label">
            Entry Date
        </label>

        <input asp-for="EntryDate"
               type="date"
               class="form-control"
               min="@openingDate.ToString("yyyy-MM-dd")" />

        <span asp-validation-for="EntryDate"
              class="text-danger small"></span>

    </div>

    <div class="col-md-4">

        <label asp-for="Head" class="form-label">Head</label>

        <select asp-for="Head"
                asp-items="heads"
                class="form-select"
                id="Head">

            <option value="">-- Select Head --</option>

        </select>

        <span asp-validation-for="Head"
              class="text-danger small"></span>

    </div>

    <div class="col-md-4" id="accountField">

        <label asp-for="Account" class="form-label">
            Account
        </label>

        <select asp-for="Account"
                asp-items="accounts"
                class="form-select"
                id="Account">

            <option value="">-- Select Account --</option>

        </select>

        <span asp-validation-for="Account"
              class="text-danger small"></span>

        <small class="text-muted" id="depositHint" style="display:none;">
            Bank Deposit moves money from Cash to Bank.
        </small>

    </div>

    <div class="col-md-8">

        <label asp-for="Details" class="form-label">
            Details
        </label>

        <input asp-for="Details"
               type="text"
               class="form-control"
               placeholder="e.g. Rifat Salary, Shop Rent, Brac Bank Deposit" />

        <span asp-validation-for="Details"
              class="text-danger small"></span>

    </div>

    <div class="col-md-4">

        <label asp-for="Amount" class="form-label">
            Amount (TK)
        </label>

        <input asp-for="Amount"
               type="number"
               step="0.01"
               min="0.01"
               class="form-control" />

        <span asp-validation-for="Amount"
              class="text-danger small"></span>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        function toggleAccount() {

            var isDeposit =
                document.getElementById("Head").value === "Bank Deposit";

            var accountSelect = document.getElementById("Account");

            document.getElementById("depositHint").style.display =
                isDeposit ? "" : "none";

            if (isDeposit) {
                accountSelect.value = "Cash";
                accountSelect.setAttribute("disabled", "disabled");
            }
            else {
                accountSelect.removeAttribute("disabled");
            }
        }

        document.getElementById("Head")
            .addEventListener("change", toggleAccount);

        toggleAccount();
    });
</script>