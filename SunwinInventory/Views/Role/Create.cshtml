@model SunwinInventory.DTOs.Role.RoleDto

@{
    ViewData["Title"] = "Create Role";
}

<div class="container-fluid">

    <div class="card">

        <div class="card-header">

            <h4>Create Role</h4>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">

                    <label asp-for="RoleName"></label>

                    <input asp-for="RoleName" class="form-control" />

                    <span asp-validation-for="RoleName" class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"></label>

                    <textarea asp-for="Description"
                              class="form-control"></textarea>

                </div>

                <div class="form-check mb-3">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label"></label>

                </div>

                <hr />

                <h5 class="mb-1">

                    <i class="bi bi-shield-check"></i>

                    Menu Permissions

                </h5>

                <p class="text-muted small mb-3">

                    Choose which menus this role can open. Create, Edit and
                    Delete control the matching actions inside each menu.

                </p>

                <partial name="_MenuPermissions" model="Model.Menus" />

                <button class="btn btn-primary">

                    Save

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <partial name="_MenuPermissionsScript" />

}
