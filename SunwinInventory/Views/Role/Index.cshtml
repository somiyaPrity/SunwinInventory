@model IEnumerable<SunwinInventory.DTOs.Role.RoleDto>

@{
    ViewData["Title"] = "Role";

    int? administratorRoleId = ViewBag.AdministratorRoleId;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold">

                <i class="bi bi-shield-lock"></i>

                Role Management

            </h3>

            <small class="text-muted">

                Manage application roles

            </small>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>

            Add Role

        </a>

    </div>

    <div class="card">

        <div class="card-header">

            <h5 class="mb-0">

                Role List

            </h5>

        </div>

        <div class="card-body">

            <table class="table table-striped table-hover datatable">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Role Name</th>

                        <th>Description</th>

                        <th>Status</th>

                        <th width="150">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.RoleId</td>

                            <td>@item.RoleName</td>

                            <td>@item.Description</td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }

                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.RoleId"
                                   class="btn btn-warning btn-sm">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                @if (administratorRoleId != item.RoleId)
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@item.RoleId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button class="btn btn-danger btn-sm btnDelete">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>