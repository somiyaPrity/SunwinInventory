@model SunwinInventory.DTOs.StockReport.StockReportDto

@{
    ViewData["Title"] = "Stock Report";

    var products = ViewBag.Products as List<SelectListItem>
        ?? new List<SelectListItem>();

    var colors = ViewBag.Colors as List<SelectListItem>
        ?? new List<SelectListItem>();

    var warehouses = ViewBag.Warehouses as List<SelectListItem>
        ?? new List<SelectListItem>();

    var shipments = ViewBag.Shipments as List<SelectListItem>
        ?? new List<SelectListItem>();

    var productNameId = ViewBag.ProductNameId?.ToString() ?? "";

    var colorId = ViewBag.ColorId?.ToString() ?? "";

    var warehouseId = ViewBag.WarehouseId?.ToString() ?? "";

    var shipmentId = ViewBag.ShipmentId?.ToString() ?? "";

    var includeZeroStock = ViewBag.IncludeZeroStock is true;
}

<div class="container-fluid">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h4 class="mb-1">
                <i class="bi bi-clipboard-data"></i>
                Stock Report
            </h4>

            <small class="text-muted">
                @Model.Title
            </small>

        </div>

        <a asp-action="ExportExcel"
           asp-route-productNameId="@ViewBag.ProductNameId"
           asp-route-colorId="@ViewBag.ColorId"
           asp-route-warehouseId="@ViewBag.WarehouseId"
           asp-route-shipmentId="@ViewBag.ShipmentId"
           asp-route-includeZeroStock="@includeZeroStock"
           class="btn btn-success">

            <i class="bi bi-file-earmark-excel"></i>
            Export Excel

        </a>

    </div>


    <!-- ===================================================== -->
    <!-- FILTERS -->
    <!-- ===================================================== -->

    <div class="card shadow-sm mb-3">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-2">

                        <label class="form-label">
                            Product
                        </label>

                        <select name="productNameId"
                                class="form-select">

                            <option value="">
                                All Products
                            </option>

                            @foreach (var product in products)
                            {
                                <option value="@product.Value"
                                        selected="@(product.Value == productNameId)">

                                    @product.Text

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            Colour
                        </label>

                        <select name="colorId"
                                class="form-select">

                            <option value="">
                                All Colours
                            </option>

                            @foreach (var color in colors)
                            {
                                <option value="@color.Value"
                                        selected="@(color.Value == colorId)">

                                    @color.Text

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            Warehouse
                        </label>

                        <select name="warehouseId"
                                class="form-select">

                            <option value="">
                                All Warehouses
                            </option>

                            @foreach (var warehouse in warehouses)
                            {
                                <option value="@warehouse.Value"
                                        selected="@(warehouse.Value == warehouseId)">

                                    @warehouse.Text

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            Shipment
                        </label>

                        <select name="shipmentId"
                                class="form-select">

                            <option value="">
                                All Shipments
                            </option>

                            @foreach (var shipment in shipments)
                            {
                                <option value="@shipment.Value"
                                        selected="@(shipment.Value == shipmentId)">

                                    @shipment.Text

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <div class="form-check">

                            <input type="checkbox"
                                   name="includeZeroStock"
                                   value="true"
                                   id="includeZeroStock"
                                   class="form-check-input"
                                   checked="@includeZeroStock" />

                            <label class="form-check-label"
                                   for="includeZeroStock">

                                Include zero stock

                            </label>

                        </div>

                    </div>

                    <div class="col-md-2">

                        <div class="d-flex gap-2 align-items-end">

                            <button type="submit"
                                    class="btn btn-primary flex-fill text-nowrap"
                                    title="Search">

                                <i class="bi bi-search"></i>

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary flex-fill text-nowrap">

                                <i class="bi bi-arrow-counterclockwise"></i>
                                Reset

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SUMMARY CARDS -->
    <!-- ===================================================== -->

    <div class="row g-3 mb-3">

        <div class="col-6 col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Products
                    </small>

                    <h5 class="fw-bold mb-0">
                        @Model.ProductCount
                    </h5>

                </div>

            </div>

        </div>

        <div class="col-6 col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Quantity (Pcs)
                    </small>

                    <h5 class="fw-bold mb-0">
                        @Model.Totals.Quantity.ToString("N0")
                    </h5>

                </div>

            </div>

        </div>

        <div class="col-6 col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Weight (KG)
                    </small>

                    <h5 class="fw-bold mb-0">
                        @Model.Totals.TotalWeightKg.ToString("N2")
                    </h5>

                </div>

            </div>

        </div>

        <div class="col-6 col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <small class="text-muted">
                        Weight (LBS)
                    </small>

                    <h5 class="fw-bold mb-0">
                        @Model.Totals.TotalWeightLbs.ToString("N2")
                    </h5>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- REPORT TABLE -->
    <!-- ===================================================== -->

    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model.Rows.Count == 0)
            {
                <p class="text-muted text-center py-4 mb-0">
                    No stock found for the selected filters.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-sm table-bordered table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th>Arrival Date</th>
                                <th>Shipment No</th>
                                <th>Product</th>
                                <th>Colour</th>
                                <th class="text-center">MM</th>
                                <th>Size</th>

                                @foreach (var warehouse in Model.Warehouses)
                                {
                                    <th class="text-end text-nowrap">
                                        @warehouse.WarehouseName
                                    </th>
                                }

                                <th class="text-end">Total Qty</th>
                                <th class="text-end">Wt/Pcs (LBS)</th>
                                <th class="text-end">Total Wt (KG)</th>
                                <th class="text-end">Total Wt (LBS)</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var row in Model.Rows)
                            {
                                <tr>

                                    <td class="text-nowrap">
                                        @(row.ArrivalDate?.ToString("dd-MM-yyyy"))
                                    </td>

                                    <td class="text-nowrap">
                                        @row.ShipmentNo
                                    </td>

                                    <td>@row.ProductName</td>

                                    <td>@row.ColorName</td>

                                    <td class="text-center">
                                        @row.Thickness
                                    </td>

                                    <td class="text-nowrap">
                                        @row.ProductSize
                                    </td>

                                    @foreach (var warehouse in Model.Warehouses)
                                    {
                                        <td class="text-end">
                                            @(row.QuantityByWarehouse
                                                .GetValueOrDefault(warehouse.WarehouseId)
                                                .ToString("N0"))
                                        </td>
                                    }

                                    <td class="text-end fw-semibold">
                                        @row.Quantity.ToString("N0")
                                    </td>

                                    <td class="text-end">
                                        @row.WeightPerPcsLbs.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @row.TotalWeightKg.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @row.TotalWeightLbs.ToString("N2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                        <tfoot class="table-secondary fw-bold">

                            <tr>

                                <td colspan="6">
                                    GRAND TOTAL
                                </td>

                                @foreach (var warehouse in Model.Warehouses)
                                {
                                    <td class="text-end">
                                        @(Model.Totals.QuantityByWarehouse
                                            .GetValueOrDefault(warehouse.WarehouseId)
                                            .ToString("N0"))
                                    </td>
                                }

                                <td class="text-end">
                                    @Model.Totals.Quantity.ToString("N0")
                                </td>

                                <td></td>

                                <td class="text-end">
                                    @Model.Totals.TotalWeightKg.ToString("N2")
                                </td>

                                <td class="text-end">
                                    @Model.Totals.TotalWeightLbs.ToString("N2")
                                </td>

                            </tr>

                        </tfoot>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
