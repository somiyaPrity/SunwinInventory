@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var controllerNames = new Dictionary<string, string>
    {
        ["Home"] = "Dashboard",
        ["Warehouse"] = "Warehouse",
        ["ProductCategory"] = "Product Category",
        ["ProductName"] = "Product Name",
        ["Supplier"] = "Supplier",
        ["Shipment"] = "Shipment",
        ["ProductPurchaseDetail"] = "Purchase",
        ["Customer"] = "Customers",
        ["Sales"] = "Sales",
        ["CustomerPayment"] = "Customer Payments",
        ["SalesReport"] = "Sales Report",
        ["StockReport"] = "Stock Report",
        ["Designation"] = "Designation",
        ["Role"] = "Role",
        ["User"] = "Users",
        ["MenuAccess"] = "Menu Access",
        ["Account"] = "Account"
    };

    var actionNames = new Dictionary<string, string>
    {
        ["ProductPurchaseDetail/Create"] = "Purchase Entry",
        ["ProductPurchaseDetail/Index"] = "Purchase Report",
        ["ProductPurchaseDetail/Edit"] = "Edit Purchase",
        ["Sales/Create"] = "Sales Entry",
        ["Sales/Index"] = "Invoice Print",
        ["Sales/Invoice"] = "Invoice Print",
        ["Sales/DownloadInvoicePdf"] = "Invoice Print",
        ["CustomerPayment/Index"] = "Customer Due Payment List",
        ["CustomerPayment/CustomerDue"] = "Customer Due Statement",
        ["CustomerPayment/Create"] = "Receive Customer Payment",
        ["CustomerPayment/CustomerPayments"] = "Customer Payment History",
        ["CustomerPayment/InvoicePayments"] = "Invoice Payment History",
        ["CustomerPayment/DownloadCustomerStatement"] = "Customer Statement",
        ["CustomerPayment/PaymentReceipt"] = "Payment Receipt",
        ["CustomerPayment/DownloadPaymentReceipt"] = "Payment Receipt",
        ["Customer/Create"] = "Add Customer",
        ["Customer/Edit"] = "Edit Customer",
        ["User/Create"] = "Create User",
        ["User/Edit"] = "Edit User",
        ["Account/Login"] = "Login",
        ["Account/ChangePassword"] = "Change Password",
        ["Home/AccessDenied"] = "Access Denied"
    };

    var controllerDisplay = controllerNames.TryGetValue(controller, out var mappedName)
        ? mappedName
        : controller;

    var pageDisplay = actionNames.TryGetValue($"{controller}/{action}", out var mappedAction)
        ? mappedAction
        : action switch
        {
            "Index" => controllerDisplay,
            "Create" => "Create " + controllerDisplay,
            "Edit" => "Edit " + controllerDisplay,
            _ => action
        };

    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName") ?? "Guest";
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName") ?? "";
}

<nav class="topbar">

    <div class="d-flex align-items-center">

        <button id="menu-toggle"
                class="btn btn-light me-3">

            <i class="bi bi-list fs-5"></i>

        </button>

        <div>

            <h5 class="mb-0 fw-bold">

                @pageDisplay

            </h5>

            <small class="text-muted">

                Home / @pageDisplay

            </small>

        </div>

    </div>

    <div class="d-flex align-items-center">

        <button class="btn btn-light position-relative me-3">

            <i class="bi bi-bell fs-5"></i>

            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">

                3

            </span>

        </button>

        <div class="dropdown">

            <button class="btn btn-light dropdown-toggle d-flex align-items-center"
                    data-bs-toggle="dropdown">

                <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-2"
                     style="width:40px;height:40px;">

                    @fullName.Substring(0,1).ToUpper()

                </div>

                <div class="text-start">

                    <div class="fw-semibold">

                        @fullName

                    </div>

                    <small class="text-muted">

                        @userName

                    </small>

                </div>

            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow">

                <li>

                    <h6 class="dropdown-header">

                        Signed in as

                        <br />

                        <strong>@userName</strong>

                    </h6>

                </li>

                <li>

                    <hr class="dropdown-divider" />

                </li>

                <li>

                    <a class="dropdown-item"
                       href="#">

                        <i class="bi bi-person me-2"></i>

                        My Profile

                    </a>

                </li>

                <li>

                    <a class="dropdown-item"
                       asp-controller="Account"
                       asp-action="ChangePassword">

                        <i class="bi bi-key me-2"></i>

                        Change Password

                    </a>

                </li>

                <li>

                    <hr class="dropdown-divider" />

                </li>

                <li>

                    <a class="dropdown-item text-danger"
                       asp-controller="Account"
                       asp-action="Logout">

                        <i class="bi bi-box-arrow-right me-2"></i>

                        Logout

                    </a>

                </li>

            </ul>

        </div>

    </div>

</nav>