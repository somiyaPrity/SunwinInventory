@inject SunwinInventory.Services.Interfaces.IPermissionService PermissionService

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();

    var roleId = Context.Session.GetInt32("RoleId");

    var access = roleId.HasValue
        ? await PermissionService.GetAccessAsync(roleId.Value)
        : new Dictionary<string, SunwinInventory.DTOs.Role.MenuAccessDto>();

    bool isAdministrator = roleId.HasValue &&
        await PermissionService.IsAdministratorAsync(roleId.Value);

    bool CanView(string key) =>
        isAdministrator ||
        (access.TryGetValue(key, out var permission) && permission.CanView);

    bool masterVisible =
        CanView("warehouse") ||
        CanView("product-category") ||
        CanView("product-name") ||
        CanView("supplier") ||
        CanView("shipment") ||
        CanView("purchase-entry");

    bool saleVisible =
        CanView("customers") ||
        CanView("sales-entry") ||
        CanView("invoice-print") ||
        CanView("customer-due") ||
        CanView("customer-due-payment");

    bool accountsVisible =
        CanView("fund-book") ||
        CanView("income-statement") ||
        CanView("balance-sheet");

    bool reportsVisible =
        CanView("purchase-report") ||
        CanView("sales-report") ||
        CanView("sales-register") ||
        CanView("stock-report") ||
        CanView("stock-movement");

    bool administrativeVisible =
        CanView("designation") ||
        CanView("role") ||
        CanView("users") ||
        CanView("menu-access");
}

<aside class="sidebar" id="sidebar">

    <!-- Logo -->
    <div class="logo">

        <div class="logo-icon">
            S
        </div>

        <div class="logo-text">

            <h5>SUNWIN</h5>

            <small>Inventory System</small>

        </div>

    </div>

    <!-- Menu -->

    <ul class="sidebar-menu">

        <li>

            <a asp-controller="Home"
               asp-action="Index"
               class="@(controller=="Home" ? "active" : "")">

                <i class="bi bi-speedometer2"></i>

                <span>Dashboard</span>

            </a>

        </li>

        @if (masterVisible)
        {
            <li class="menu-title">

                <span>MASTER SETUP</span>

            </li>

            @if (CanView("warehouse"))
            {
                <li>

                    <a asp-controller="Warehouse"
                       asp-action="Index"
                       class="@(controller=="Warehouse" ? "active" : "")">

                        <i class="bi bi-building"></i>

                        <span>Warehouse</span>

                    </a>

                </li>
            }

            @if (CanView("product-category"))
            {
                <li>

                    <a asp-controller="ProductCategory"
                       asp-action="Index"
                       class="@(controller=="ProductCategory" ? "active" : "")">

                        <i class="bi bi-tags"></i>

                        <span>Product Category</span>

                    </a>

                </li>
            }

            @if (CanView("product-name"))
            {
                <li>

                    <a asp-controller="ProductName"
                       asp-action="Index"
                       class="@(controller == "ProductName" ? "active" : "")">

                        <i class="bi bi-box-seam"></i>

                        <span>Product Name</span>

                    </a>

                </li>
            }

            @if (CanView("supplier"))
            {
                <li>

                    <a asp-controller="Supplier"
                       asp-action="Index"
                       class="@(controller=="Supplier" ? "active" : "")">

                        <i class="bi bi-truck"></i>

                        <span>Supplier</span>

                    </a>

                </li>
            }

            @if (CanView("shipment"))
            {
                <li>

                    <a asp-controller="Shipment"
                       asp-action="Index"
                       class="@(controller=="Shipment" ? "active" : "")">

                        <i class="bi bi-truck"></i>

                        <span>Shipment</span>

                    </a>

                </li>
            }

            @if (CanView("purchase-entry"))
            {
                <li>
                    <a asp-controller="ProductPurchaseDetail"
                       asp-action="Create"
                       class="@((controller=="ProductPurchaseDetail" && action=="Create") ? "active" : "")">

                        <i class="bi bi-cart-plus"></i>

                        <span>Purchase Entry</span>

                    </a>
                </li>
            }
        }

        @if (saleVisible)
        {
            <li class="menu-title">

                <span>Sale</span>

            </li>

            @if (CanView("customers"))
            {
                <li>
                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="@(controller == "Customer" ? "active" : "")">

                        <i class="bi bi-people"></i>

                        <span>Customers</span>

                    </a>
                </li>
            }

            @if (CanView("sales-entry"))
            {
                <li>
                    <a asp-controller="Sales"
                       asp-action="Create"
                       class="@((controller == "Sales" && action == "Create") ? "active" : "")">

                        <i class="bi bi-arrow-left-right"></i>

                        <span>Sales Entry</span>

                    </a>
                </li>
            }

            @if (CanView("invoice-print"))
            {
                <li>
                    <a asp-controller="Sales"
                       asp-action="Index"
                       class="@((controller == "Sales" && (action == "Index" || action == "DownloadInvoicePdf")) ? "active" : "")">

                        <i class="bi bi-printer"></i>

                        <span>Invoice Print</span>

                    </a>
                </li>
            }

            @if (CanView("customer-due"))
            {
                <li class="nav-item">
                    <a class="nav-link"
                       asp-controller="CustomerPayment"
                       asp-action="CustomerDue">

                        <i class="bi bi-hourglass-split me-2"></i>
                        Receivables

                    </a>
                </li>
            }

            @if (CanView("customer-due-payment"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="CustomerPayment" asp-action="Index">
                        <i class="bi bi-cash-coin me-2"></i>
                        Customer Due Payment List
                    </a>
                </li>
            }
        }

        @if (accountsVisible)
        {
            <li class="menu-title">

                <span>Accounts</span>

            </li>

            @if (CanView("fund-book"))
            {
                <li>

                    <a asp-controller="Fund"
                       asp-action="Index"
                       class="@(controller == "Fund" ? "active" : "")">

                        <i class="bi bi-journal-text"></i>

                        <span>Fund Book</span>

                    </a>

                </li>
            }

            @if (CanView("income-statement"))
            {
                <li>

                    <a asp-controller="FinancialReport"
                       asp-action="IncomeStatement"
                       class="@(controller == "FinancialReport" && action == "IncomeStatement" ? "active" : "")">

                        <i class="bi bi-graph-up-arrow"></i>

                        <span>Income Statement</span>

                    </a>

                </li>
            }

            @if (CanView("balance-sheet"))
            {
                <li>

                    <a asp-controller="FinancialReport"
                       asp-action="BalanceSheet"
                       class="@(controller == "FinancialReport" && action == "BalanceSheet" ? "active" : "")">

                        <i class="bi bi-bank"></i>

                        <span>Balance Sheet</span>

                    </a>

                </li>
            }
        }

        @if (reportsVisible)
        {
            <li class="menu-title">

                <span>REPORTS</span>

            </li>

            @if (CanView("purchase-report"))
            {
                <li>
                    <a asp-controller="ProductPurchaseDetail"
                       asp-action="Index"
                       class="@((controller=="ProductPurchaseDetail" && action=="Index") ? "active" : "")">

                        <i class="bi bi-receipt"></i>

                        <span>Purchase Report</span>

                    </a>
                </li>
            }

            @if (CanView("sales-report"))
            {
                <li>
                    <a asp-controller="SalesReport"
                       asp-action="Index"
                       class="@(controller == "SalesReport" && action == "Index" ? "active" : "")">

                        <i class="bi bi-bar-chart"></i>

                        <span>Sales Report</span>

                    </a>
                </li>
            }

            @if (CanView("sales-register"))
            {
                <li>
                    <a asp-controller="SalesReport"
                       asp-action="Register"
                       class="@(controller == "SalesReport" && action == "Register" ? "active" : "")">

                        <i class="bi bi-journal-richtext"></i>

                        <span>Sales Register</span>

                    </a>
                </li>
            }

            @if (CanView("stock-report"))
            {
                <li>

                    <a asp-controller="StockReport"
                       asp-action="Index"
                       class="@(controller == "StockReport" && (action == "Index" || action == "ExportExcel") ? "active" : "")">

                        <i class="bi bi-clipboard-data"></i>

                        <span>Stock Report</span>

                    </a>

                </li>
            }

            @if (CanView("stock-movement"))
            {
                <li>

                    <a asp-controller="StockReport"
                       asp-action="Movement"
                       class="@(controller == "StockReport" && action == "Movement" ? "active" : "")">

                        <i class="bi bi-calendar3"></i>

                        <span>Stock Movement</span>

                    </a>

                </li>
            }
        }

        @if (administrativeVisible)
        {
            <li class="menu-title">

                <span>Administrative</span>

            </li>

            @if (CanView("designation"))
            {
                <li>

                    <a asp-controller="Designation"
                       asp-action="Index"
                       class="@(controller=="Designation" ? "active" : "")">

                        <i class="bi bi-person-badge"></i>

                        <span>Designation</span>

                    </a>

                </li>
            }

            @if (CanView("role"))
            {
                <li>

                    <a asp-controller="Role"
                       asp-action="Index"
                       class="@(controller=="Role" ? "active" : "")">

                        <i class="bi bi-shield-lock"></i>

                        <span>Role</span>

                    </a>

                </li>
            }

            @if (CanView("users"))
            {
                <li>

                    <a asp-controller="User"
                       asp-action="Index"
                       class="@(controller=="User" ? "active" : "")">

                        <i class="bi bi-people-fill"></i>

                        <span>Users</span>

                    </a>

                </li>
            }

            @if (CanView("menu-access"))
            {
                <li>

                    <a asp-controller="MenuAccess"
                       asp-action="Index"
                       class="@(controller=="MenuAccess" ? "active" : "")">

                        <i class="bi bi-ui-checks"></i>

                        <span>Menu Access</span>

                    </a>

                </li>
            }
        }

    </ul>

</aside>
