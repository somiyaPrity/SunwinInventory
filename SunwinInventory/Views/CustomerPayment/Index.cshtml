@model IEnumerable<SunwinInventory.DTOs.CustomerPayment.CustomerPaymentDto>

@{
    ViewData["Title"] = "Customer Payments";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4>
            <i class="bi bi-cash-stack"></i>
            Customer Payments
        </h4>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>
            Receive Payment

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table id="paymentTable"
                       class="table table-bordered table-striped table-hover">

                    <thead class="table-dark">

                        <tr>

                            <th>SL</th>

                            <th>Date</th>

                            <th>Customer</th>

                            <th>Invoice No</th>

                            <th class="text-end">
                                Invoice Total
                            </th>

                            <th class="text-end">
                                Payment
                            </th>

                            <th class="text-end">
                                Paid
                            </th>

                            <th class="text-end">
                                Due
                            </th>

                            <th>Method</th>

                            <th>Remarks</th>

                            <th width="120">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int sl = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @sl
                                </td>

                                <td>
                                    @item.PaymentDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @item.CustomerName
                                </td>

                                <td>
                                    @item.InvoiceNo
                                </td>

                                <td class="text-end">
                                    @item.InvoiceTotal.ToString("N2")
                                </td>

                                <td class="text-end fw-bold">
                                    @item.PaymentAmount.ToString("N2")
                                </td>

                                <td class="text-end">
                                    @item.InvoicePaidAmount.ToString("N2")
                                </td>

                                <td class="text-end">

                                    @if (item.InvoiceDueAmount > 0)
                                    {
                                        <span class="text-danger fw-bold">
                                            @item.InvoiceDueAmount.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold">
                                            0.00
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.PaymentMethod
                                </td>

                                <td>
                                    @item.Remarks
                                </td>

                                <td>

                                    <a asp-action="InvoicePayments"
                                       asp-route-salesInvoiceId="@item.SalesInvoiceId"
                                       class="btn btn-info btn-sm">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <button type="button"
                                            class="btn btn-danger btn-sm btnDelete"
                                            data-id="@item.CustomerPaymentId">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </td>

                            </tr>

                            sl++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            $("#paymentTable").DataTable({

                pageLength: 25,

                lengthMenu: [10, 25, 50, 100],

                scrollX: true,

                ordering: true,

                searching: true,

                columnDefs: [
                    {
                        targets: "_all",
                        className: "text-nowrap"
                    }
                ]

            });

            $(".btnDelete").click(function () {

                if (!confirm("Are you sure you want to delete this payment?"))
                    return;

                var id = $(this).data("id");

                var form = $('<form>', {
                    method: 'post',
                    action: '/CustomerPayment/Delete/' + id
                });

                var token = $('input[name="__RequestVerificationToken"]').first().val();

                if (token) {

                    form.append(
                        $('<input>', {
                            type: 'hidden',
                            name: '__RequestVerificationToken',
                            value: token
                        })
                    );

                }

                $('body').append(form);

                form.submit();

            });

        });

    </script>

}