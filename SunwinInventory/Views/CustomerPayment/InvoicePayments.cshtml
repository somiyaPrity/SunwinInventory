@model IEnumerable<SunwinInventory.DTOs.CustomerPayment.CustomerPaymentDto>

@{
    ViewData["Title"] = "Invoice Payment History";

    var first = Model.FirstOrDefault();
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h4>
                <i class="bi bi-receipt"></i>
                Invoice Payment History
            </h4>

            @if (first != null)
            {
                <div class="text-muted">

                    Invoice:
                    <strong>
                        @first.InvoiceNo
                    </strong>

                    |

                    Customer:
                    <strong>
                        @first.CustomerName
                    </strong>

                </div>
            }

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>


    @if (first != null)
    {
        <div class="row mb-3">

            <div class="col-md-4">

                <div class="card border-primary shadow-sm">

                    <div class="card-body">

                        <small class="text-muted">
                            Invoice Total
                        </small>

                        <h4 class="text-primary">
                            @first.InvoiceTotal.ToString("N2")
                        </h4>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card border-success shadow-sm">

                    <div class="card-body">

                        <small class="text-muted">
                            Total Paid
                        </small>

                        <h4 class="text-success">
                            @first.InvoicePaidAmount.ToString("N2")
                        </h4>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card border-danger shadow-sm">

                    <div class="card-body">

                        <small class="text-muted">
                            Current Due
                        </small>

                        <h4 class="text-danger">
                            @first.InvoiceDueAmount.ToString("N2")
                        </h4>

                    </div>

                </div>

            </div>

        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body">

            <table id="invoicePaymentTable"
                   class="table table-bordered table-striped table-hover">

                <thead class="table-dark">

                    <tr>

                        <th>SL</th>

                        <th>Date</th>

                        <th>Payment Amount</th>

                        <th>Payment Method</th>

                        <th>Remarks</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int sl = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @sl
                            </td>

                            <td>
                                @item.PaymentDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td class="text-end fw-bold">
                                @item.PaymentAmount.ToString("N2")
                            </td>

                            <td>
                                @item.PaymentMethod
                            </td>

                            <td>
                                @item.Remarks
                            </td>

                        </tr>

                        sl++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        $(document).ready(function () {

            $("#invoicePaymentTable").DataTable({

                pageLength: 25,

                lengthMenu: [10, 25, 50, 100],

                ordering: true,

                searching: true,

                scrollX: true

            });

        });

    </script>

}