@model SunwinInventory.DTOs.Warehouse.WarehouseDto

@{
    ViewData["Title"] = "Edit Warehouse";
}

<div class="container mt-4">

    <div class="card">

        <div class="card-header bg-warning">

            <h4>Edit Warehouse</h4>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="WarehouseId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">

                    <label asp-for="WarehouseName"></label>

                    <input asp-for="WarehouseName" class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Address"></label>

                    <textarea asp-for="Address" class="form-control"></textarea>

                </div>

                <div class="mb-3">

                    <label asp-for="Phone"></label>

                    <input asp-for="Phone" class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Email"></label>

                    <input asp-for="Email" class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="ContactPerson"></label>

                    <input asp-for="ContactPerson" class="form-control" />

                </div>

                <div class="form-check mb-3">

                    <input asp-for="IsActive" class="form-check-input" />

                    <label asp-for="IsActive" class="form-check-label"></label>

                </div>

                <button class="btn btn-primary">

                    Update

                </button>

                <a asp-action="Index" class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}