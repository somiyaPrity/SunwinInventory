
@model IEnumerable<SunwinInventory.DTOs.Warehouse.WarehouseDto>

@{
    ViewData["Title"] = "Warehouse";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-building"></i>
                Warehouse Management
            </h3>

            <small class="text-muted">
                Manage all warehouses from one place.
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>

            Add Warehouse

        </a>

    </div>

    <!-- Card -->

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Warehouse List

            </h5>

        </div>

        <div class="card-body">

            <table class="table table-striped table-hover align-middle datatable">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Name</th>

                        <th>Phone</th>

                        <th>Email</th>

                        <th>Contact Person</th>

                        <th>Status</th>

                        <th width="150">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.WarehouseId</td>

                            <td>@item.WarehouseName</td>

                            <td>@item.Phone</td>

                            <td>@item.Email</td>

                            <td>@item.ContactPerson</td>

                            <td>

                                @if (item.IsActive == true)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.WarehouseId"
                                   class="btn btn-warning btn-sm">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.WarehouseId"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-danger btn-sm btnDelete">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>