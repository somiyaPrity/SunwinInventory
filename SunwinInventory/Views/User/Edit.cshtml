@model SunwinInventory.DTOs.User.UserDto

@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid">

    <div class="card">

        <div class="card-header">

            <h4>Edit User</h4>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="UserId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="FullName"></label>

                        <input asp-for="FullName" class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="UserName"></label>

                        <input asp-for="UserName" class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Password</label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"></label>

                        <input asp-for="Email" class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Phone"></label>

                        <input asp-for="Phone" class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Role</label>

                        <select asp-for="RoleId"
                                asp-items="ViewBag.Roles"
                                class="form-select"></select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Designation</label>

                        <select asp-for="DesignationId"
                                asp-items="ViewBag.Designations"
                                class="form-select"></select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Warehouse</label>

                        <select asp-for="WarehouseId"
                                asp-items="ViewBag.Warehouses"
                                class="form-select"></select>

                    </div>

                    <div class="col-md-12">

                        <div class="form-check">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label"></label>

                        </div>

                    </div>

                </div>

                <hr />

                <button class="btn btn-primary">

                    Update

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}