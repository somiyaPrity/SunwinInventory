@model SunwinInventory.DTOs.MenuAccess.MenuAccessViewModel

@{
    ViewData["Title"] = "Menu Access";

    ViewData["Disabled"] = Model.IsAdministrator;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-ui-checks"></i>

                Menu Access

            </h3>

            <small class="text-muted">

                Control which menus each role can open and change

            </small>

        </div>

        <a asp-controller="Role"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-shield-lock"></i>

            Manage Roles

        </a>

    </div>

    <div class="card mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">

                        <label class="form-label">Role</label>

                        <select name="roleId"
                                class="form-select"
                                onchange="this.form.submit()">

                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.Value"
                                        selected="@(role.Value == Model.RoleId.ToString())">

                                    @role.Text

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-8">

                        <div class="text-muted small pb-2">

                            Select a role to view and edit its menu
                            permissions.

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    @if (Model.Roles.Count == 0)
    {
        <div class="alert alert-warning">

            No roles found. Create a role first.

        </div>
    }
    else
    {
        <form asp-action="Save" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="roleId" value="@Model.RoleId" />

            <div class="card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">

                        @Model.RoleName Permissions

                    </h5>

                    <button class="btn btn-primary"
                            disabled="@Model.IsAdministrator">

                        <i class="bi bi-check2-circle"></i>

                        Save Changes

                    </button>

                </div>

                <div class="card-body">

                    @if (Model.IsAdministrator)
                    {
                        <div class="alert alert-info py-2 small">

                            The Administrator role always has full access, so
                            its menu permissions cannot be changed.

                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">

                            View controls whether the menu appears in the
                            sidebar. Create, Edit and Delete control the
                            matching actions inside that menu. Checking any
                            action automatically grants View.

                        </p>
                    }

                    <partial name="_MenuPermissions" model="Model.Menus" />

                </div>

                <div class="card-footer d-flex gap-2">

                    <button class="btn btn-primary"
                            disabled="@Model.IsAdministrator">

                        Save Changes

                    </button>

                    <a asp-controller="Role"
                       asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </div>

        </form>
    }

</div>

@section Scripts {

    <partial name="_MenuPermissionsScript" />

}
